---
/** "You might also be interested in" rail at the foot of a post. */
import PostCard from './PostCard.astro';
import type { Post } from '../lib/posts';

interface Props {
  posts: Post[];
  lang?: 'en' | 'es';
}

const { posts, lang = 'en' } = Astro.props;

const title = {
  en: 'You might also be interested in',
  es: 'También te puede interesar',
}[lang];
---
{posts.length > 0 && (
  <aside class="related" id="related">
    <div class="wrap">
      <h2 class="related-title">{title}</h2>
      <div class="post-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </aside>
)}
