---
/**
 * Detail page for one infographic, in either language.
 *
 * Deliberately leaner than the article template. Someone arriving here has
 * clicked a pin and wants the chart — so the image is the page, at full width,
 * with the save action next to it and a short blurb underneath. There is no
 * prose column, no related rail and no prev/next: those serve a reader working
 * through an archive, which is not this traffic.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { formatDate, postHref, type Post } from '../lib/posts';
import { pinCreateHref, pinDescriptionFor } from '../lib/pinterest';

interface Props {
  post: Post;
  translation?: Post;
  /** Rendered Markdown body — the short blurb under the chart. */
  body?: any;
}

const { post, translation, body: Body } = Astro.props;
const { data } = post;
const lang = data.lang;

const T = {
  en: {
    section: 'Infographics',
    home: 'Home',
    save: 'Save this pin',
    share: 'Share',
    copied: 'Link copied',
    ctaTitle: 'Plan it in Garden Pro Planner',
    ctaBody:
      'Lay out your beds around a 265+ plant library and your own frost dates, with a planting calendar, pest guides and yield tracking.',
    ctaBtn: 'Get the free app',
    alsoIn: 'Ver en español',
  },
  es: {
    section: 'Infografías',
    home: 'Inicio',
    save: 'Guardar en Pinterest',
    share: 'Compartir',
    copied: 'Enlace copiado',
    ctaTitle: 'Planifícalo en Garden Pro Planner',
    ctaBody:
      'Diseña tus bancales con una biblioteca de más de 265 plantas y tus propias fechas de heladas, con calendario de siembra, guías de plagas y registro de cosecha.',
    ctaBtn: 'Descarga la app gratis',
    alsoIn: 'Read in English',
  },
}[lang];

const href = postHref(post);
const url = new URL(href, Astro.site).href;
const image = new URL(data.infographicImage ?? '/assets/app-icon.png', Astro.site).href;

const pinDescription = pinDescriptionFor(data);
const pinHref = pinCreateHref(url, image, pinDescription);

const sectionHref = lang === 'es' ? '/es/infographics/' : '/infographics/';
const crumbs = [
  { name: T.home, href: lang === 'es' ? '/es/infographics/' : '/' },
  { name: T.section, href: sectionHref },
  { name: data.title, href },
];

const alternates = translation
  ? [
      { lang, href: url },
      { lang: translation.data.lang, href: new URL(postHref(translation), Astro.site).href },
      { lang: 'x-default', href: lang === 'en' ? url : new URL(postHref(translation), Astro.site).href },
    ]
  : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  name: data.title,
  description: data.description,
  contentUrl: image,
  datePublished: data.date.toISOString(),
  inLanguage: lang,
  creditText: 'Garden Pro Planner',
  creator: { '@type': 'Organization', name: 'Garden Pro Planner' },
  isPartOf: { '@type': 'WebPage', '@id': url },
};
---
<BaseLayout
  title={`${data.title} — Garden Pro Planner`}
  description={data.description}
  canonical={url}
  image={image}
  type="article"
  lang={lang}
  alternates={alternates}
  publishedTime={data.date.toISOString()}
  modifiedTime={(data.updated ?? data.date).toISOString()}
  articleTags={data.pinKeywords ?? data.tags}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <article class="section">
    <div class="wrap wrap-narrow">
      <Breadcrumbs items={crumbs} />
      <header class="post-header">
        <h1>{data.title}</h1>
        <p class="post-meta">
          <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
          {translation && (
            <span> · <a href={postHref(translation)} rel="alternate" hreflang={translation.data.lang}>{T.alsoIn}</a></span>
          )}
        </p>
      </header>

      {data.infographicImage && (
        <figure class="post-hero">
          <img
            class="post-hero-img"
            src={data.infographicImage}
            alt={data.imageAlt ?? data.infographicTitle ?? data.title}
            loading="eager"
            width="1000"
            height="1500"
            fetchpriority="high"
            data-pin-media={image}
            data-pin-url={url}
            data-pin-description={pinDescription}
          />
          <div class="hero-actions">
            <a
              class="pin-btn"
              href={pinHref}
              target="_blank"
              rel="noopener nofollow"
              data-cta="pinterest-save"
              aria-label={T.save}
            >
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
              <span>{T.save}</span>
            </a>
            <button
              class="share-btn"
              type="button"
              data-share-url={url}
              data-share-title={data.title}
              data-share-text={data.description}
              data-copied={T.copied}
              data-cta="share"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
              <span class="share-label">{T.share}</span>
            </button>
          </div>
        </figure>
      )}

      {Body && (
        <div class="prose">
          <Body />
        </div>
      )}

      <aside class="post-cta">
        <h3>{T.ctaTitle}</h3>
        <p>{T.ctaBody}</p>
        <a class="btn" href="https://apps.apple.com/app/id1539031278" data-cta="post-footer">{T.ctaBtn}</a>
      </aside>
    </div>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.share-btn').forEach((btn) => {
    const label = btn.querySelector('.share-label');
    btn.addEventListener('click', async () => {
      const { shareUrl, shareTitle, shareText, copied } = btn.dataset;
      if (!shareUrl) return;

      if (navigator.share) {
        try {
          await navigator.share({ title: shareTitle, text: shareText, url: shareUrl });
        } catch {
          /* reader dismissed the sheet */
        }
        return;
      }

      try {
        await navigator.clipboard.writeText(shareUrl);
        if (!label) return;
        const original = label.textContent;
        label.textContent = copied ?? 'Link copied';
        btn.classList.add('is-copied');
        setTimeout(() => {
          label.textContent = original;
          btn.classList.remove('is-copied');
        }, 2000);
      } catch {
        window.prompt('Copy this link:', shareUrl);
      }
    });
  });
</script>
