---
/** Links to the posts published either side of this one, in the same language. */
import { postHref, type Post } from '../lib/posts';

interface Props {
  newer?: Post;
  older?: Post;
  lang?: 'en' | 'es';
}

const { newer, older, lang = 'en' } = Astro.props;

const T = {
  en: { label: 'More posts', newer: '← Newer post', older: 'Older post →' },
  es: { label: 'Más artículos', newer: '← Artículo más reciente', older: 'Artículo anterior →' },
}[lang];
---
{(newer || older) && (
  <nav class="post-nav" aria-label={T.label}>
    {newer ? (
      <a class="post-nav-link post-nav-newer" href={postHref(newer)} rel="prev">
        <span class="post-nav-dir">{T.newer}</span>
        <span class="post-nav-title">{newer.data.title}</span>
      </a>
    ) : (
      /* Keeps a lone "older" link pinned to the right of the row. */
      <span aria-hidden="true"></span>
    )}
    {older && (
      <a class="post-nav-link post-nav-older" href={postHref(older)} rel="next">
        <span class="post-nav-dir">{T.older}</span>
        <span class="post-nav-title">{older.data.title}</span>
      </a>
    )}
  </nav>
)}
