---
/**
 * One blog article, in either language.
 *
 * English articles render at /blog/<slug>/ and their Spanish translations at
 * /es/blog/<slug>/; both routes are thin wrappers over this component so the
 * two versions can't drift apart in layout, metadata or CTAs. Everything a
 * reader sees that isn't the post itself comes from the copy table `T`.
 */
import { render } from 'astro:content';
import { storeUrl } from '../lib/stores';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostNav from './PostNav.astro';
import RelatedPosts from './RelatedPosts.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import TagRow from './TagRow.astro';
import { formatDate, postHref, blogHref, type Post } from '../lib/posts';

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
  related: Post[];
  /** Tag slugs that have a hub page. Only English pages link their tags. */
  linkedTags: string[];
  /** The other language's version of this article, when it's live. */
  translation?: Post;
}

const { post, newer, older, related, linkedTags, translation } = Astro.props;
const { Content } = await render(post);
const { data } = post;
const lang = data.lang;

const T = {
  en: {
    home: 'Home',
    blog: 'Blog',
    crumbsLabel: 'Breadcrumb',
    updated: 'Updated',
    saveLabel: 'Save this post to Pinterest',
    save: 'Save this pin',
    share: 'Share',
    copied: 'Link copied',
    copyPrompt: 'Copy this link:',
    ctaTitle: "Get next season's dates right",
    ctaBody:
      'Garden Planner Pro builds your planting calendar from your own local frost dates, lays out every bed square by square, and totals up what each harvest saved you.',
    ctaBtn: 'Get the free app',
    ctaFoot: 'Free on iPhone, iPad and Android · 440+ plants · nine languages',
    alsoIn: 'Ver en español',
  },
  es: {
    home: 'Inicio',
    blog: 'Blog',
    crumbsLabel: 'Ruta de navegación',
    updated: 'Actualizado',
    saveLabel: 'Guardar este artículo en Pinterest',
    save: 'Guardar en Pinterest',
    share: 'Compartir',
    copied: 'Enlace copiado',
    copyPrompt: 'Copia este enlace:',
    ctaTitle: 'Acierta con las fechas de la próxima temporada',
    ctaBody:
      'Garden Planner Pro crea tu calendario de siembra a partir de las fechas de heladas de tu zona, organiza cada bancal cuadro a cuadro y suma lo que te ahorra cada cosecha.',
    ctaBtn: 'Descarga la app gratis',
    ctaFoot: 'Gratis en iPhone, iPad y Android · más de 440 plantas · nueve idiomas',
    alsoIn: 'Read in English',
  },
}[lang];

const href = postHref(post);
const url = new URL(href, Astro.site).href;
const image = data.image
  ? new URL(data.image, Astro.site).href
  : 'https://thegardenplanner.app/assets/app-icon-v2.png';

// Pinterest wants the tall 2:3 image with the title burned in, not the clean
// hero. Fall back to the hero so a post without a pin image still pins.
const pinImage = data.pinImage ? new URL(data.pinImage, Astro.site).href : image;

// Pinterest ranks mostly on the words in the description, so the readable
// sentence does the work. The hashtags are reinforcement, capped at 5 and
// placed last, which is what Pinterest's own guidance asks for.
const hashtag = (s: string) =>
  '#' + s.trim().split(/[\s\-_]+/).map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join('');
const pinTags = (data.pinKeywords ?? data.tags).slice(0, 5).map(hashtag).join(' ');
// The pin headline: the punchier short title where a post defines one. Note
// this is NOT the og:title — see the BaseLayout call below.
const pinTitle = data.pinTitle ?? data.title;
const pinDescription =
  `${pinTitle}. ${data.description}` + (pinTags ? ` ${pinTags}` : '');
const pinHref =
  'https://www.pinterest.com/pin/create/button/' +
  `?url=${encodeURIComponent(url)}` +
  `&media=${encodeURIComponent(pinImage)}` +
  `&description=${encodeURIComponent(pinDescription)}`;

// There is no Spanish landing page, so "Inicio" stays inside the Spanish
// section rather than dropping the reader onto an English page — the same
// choice the Spanish infographics make.
const crumbs = [
  { name: T.home, href: lang === 'es' ? blogHref('es') : '/' },
  { name: T.blog, href: blogHref(lang) },
  { name: data.title, href },
];

// Every version must list every version, itself included, or Google ignores
// the set. x-default is the English page, which is what any other locale gets.
const translationUrl = translation ? new URL(postHref(translation), Astro.site).href : undefined;
const alternates =
  translation && translationUrl
    ? [
        { lang, href: url },
        { lang: translation.data.lang, href: translationUrl },
        { lang: 'x-default', href: lang === 'en' ? url : translationUrl },
      ]
    : [];

// Article structured data helps Google understand and surface the post.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  image,
  datePublished: data.date.toISOString(),
  dateModified: (data.updated ?? data.date).toISOString(),
  inLanguage: lang,
  author: { '@type': 'Person', name: 'Kalden Ficklin', url: 'https://thegardenplanner.app/about/' },
  publisher: {
    '@type': 'Organization',
    '@id': 'https://thegardenplanner.app/#organization',
    name: 'Garden Planner Pro',
    logo: { '@type': 'ImageObject', url: 'https://thegardenplanner.app/assets/app-icon-v2.png' },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
};

// Google renders a breadcrumb trail in place of the raw URL on a search result,
// which on a phone is most of the visible line. The <nav> above already shows
// this trail; this is the machine-readable half of the same thing.
const crumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: new URL(c.href, Astro.site).href,
  })),
};
---
<BaseLayout
  title={`${data.title} — Garden Planner Pro`}
  ogTitle={data.title}
  description={data.description}
  canonical={url}
  image={image}
  type="article"
  lang={lang}
  alternates={alternates}
  publishedTime={data.date.toISOString()}
  modifiedTime={(data.updated ?? data.date).toISOString()}
  articleTags={data.pinKeywords ?? data.tags}
  storePage={data.storePage}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(crumbLd)} />

  <article class="section">
    <div class="wrap wrap-narrow">
      <Breadcrumbs items={crumbs} label={T.crumbsLabel} />
      <header class="post-header">
        <h1>{data.title}</h1>
        <p class="post-meta">
          <time datetime={data.date.toISOString()}>{formatDate(data.date, lang)}</time>
          {data.updated && <span> · {T.updated} {formatDate(data.updated, lang)}</span>}
          {translation && (
            <span> · <a href={postHref(translation)} rel="alternate" hreflang={translation.data.lang}>{T.alsoIn}</a></span>
          )}
        </p>
        {/* Tag hubs are English-only and their labels come from the English
            TAG_COPY, so a Spanish page would show English words linking to an
            English page. The tags still rank its related posts. */}
        {lang === 'en' && <TagRow tags={data.tags} linked={linkedTags} />}
      </header>

      {data.image && (
        <figure class="post-hero">
          {/* data-pin-media points Pinterest's browser extension at the titled
              2:3 pin instead of this clean hero. */}
          <img
            class="post-hero-img"
            src={data.image}
            alt={data.imageAlt ?? data.title}
            loading="eager"
            {/* This is the LCP element. The intrinsic size reserves its box so
                the article below doesn't jump when it lands, and fetchpriority
                pulls it ahead of the other images in the queue. Heroes are
                1200x800 (scripts/make-images.mjs). */}
            width={1200}
            height={800}
            fetchpriority="high"
            data-pin-media={pinImage}
            data-pin-title={pinTitle}
            data-pin-description={pinDescription}
          />
          <div class="hero-actions">
          <a
            class="pin-btn"
            href={pinHref}
            target="_blank"
            rel="noopener nofollow"
            data-cta="pinterest-save"
            aria-label={T.saveLabel}
          >
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
            <span>{T.save}</span>
          </a>
          {/* Opens the OS share sheet on mobile (Messages, WhatsApp, Facebook,
              email, whatever the reader actually uses). Falls back to copying
              the link on desktop, where Web Share is patchy. The fallback's
              wording rides along as data attributes, because the script below
              is bundled once for both languages. */}
          <button
            class="share-btn"
            type="button"
            data-share-url={url}
            data-share-title={data.title}
            data-share-text={data.description}
            data-copied={T.copied}
            data-copy-prompt={T.copyPrompt}
            data-cta="share"
          >
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            <span class="share-label">{T.share}</span>
          </button>
          </div>
        </figure>
      )}

      <div class="prose">
        <Content />
      </div>

      {/* Off-screen copy of the pin so Pinterest's "save from URL" flow offers
          the branded 2:3 image. Lazy + off-screen, so it costs readers nothing. */}
      {data.pinImage && (
        <div class="pin-source" aria-hidden="true">
          <img
            src={data.pinImage}
            alt={pinTitle}
            loading="lazy"
            width="1000"
            height="1500"
            data-pin-title={pinTitle}
            data-pin-description={pinDescription}
          />
        </div>
      )}

      <PostNav newer={newer} older={older} lang={lang} />

      {/* The end-of-post CTA. Most readers never reach it — that is what the
          mid-article one placed by rehype-app-cta.mjs is for — so this one is
          written for the reader who did read to the end, and leads with the
          next season rather than with this post's crop. */}
      <aside class="post-cta">
        <h3>{T.ctaTitle}</h3>
        <p>{T.ctaBody}</p>
        <a
          class="btn"
          href={storeUrl('ios', data.storePage)}
          data-play-href={storeUrl('android', data.storePage)}
          data-store-link
          data-cta="post-footer"
        >{T.ctaBtn}</a>
        <p class="post-cta-foot">{T.ctaFoot}</p>
      </aside>
    </div>

    <RelatedPosts posts={related} lang={lang} />
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.share-btn').forEach((btn) => {
    const label = btn.querySelector('.share-label');
    btn.addEventListener('click', async () => {
      const { shareUrl, shareTitle, shareText, copied, copyPrompt } = btn.dataset;
      if (!shareUrl) return;

      if (navigator.share) {
        try {
          await navigator.share({ title: shareTitle, text: shareText, url: shareUrl });
        } catch {
          /* reader dismissed the sheet */
        }
        return;
      }

      try {
        await navigator.clipboard.writeText(shareUrl);
        if (!label) return;
        const original = label.textContent;
        label.textContent = copied ?? 'Link copied';
        btn.classList.add('is-copied');
        setTimeout(() => {
          label.textContent = original;
          btn.classList.remove('is-copied');
        }, 2000);
      } catch {
        window.prompt(copyPrompt ?? 'Copy this link:', shareUrl);
      }
    });
  });
</script>
