---
/**
 * One page of the blog index. Shared by /blog/ (page 1) and /blog/page/N/, so
 * the two routes only have to work out which slice of posts they are showing.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreBadges from './StoreBadges.astro';
import PostList from './PostList.astro';
import Pagination from './Pagination.astro';
import type { Post } from '../lib/posts';
import { pageHref } from '../lib/posts';

interface Props {
  posts: Post[];
  current: number;
  total: number;
}

const { posts, current, total } = Astro.props;

const canonical = new URL(pageHref(current), Astro.site).href;
const prev = current > 1 ? new URL(pageHref(current - 1), Astro.site).href : null;
const next = current < total ? new URL(pageHref(current + 1), Astro.site).href : null;

// Page 2 onward gets its own title so the pages don't compete for the same
// query, and its own description so search results aren't identical.
const title =
  current === 1
    ? 'The Garden Pro Planner Blog — Grow a Better Garden'
    : `The Garden Pro Planner Blog — Page ${current}`;
const description =
  current === 1
    ? 'Practical gardening guides: when to plant, companion planting, pest control, seed starting, and harvest tips — from the team behind Garden Pro Planner.'
    : `Page ${current} of the Garden Pro Planner blog: more guides on planting times, companion planting, pest control, and getting a bigger harvest.`;
---
<BaseLayout title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    {prev && <link rel="prev" href={prev} />}
    {next && <link rel="next" href={next} />}
  </Fragment>

  <section class="blog-hero">
    <div class="wrap wrap-narrow">
      <p class="eyebrow">The Garden Pro Planner Blog</p>
      <h1>Grow a better garden</h1>
      <p class="lead">Planting guides, timing charts, and season-by-season advice to help you plan, grow, and harvest more.</p>
      <p class="ig-meta">Prefer pictures? Browse the <a href="/infographics/">garden infographics</a> — save-and-keep reference charts, two new ones every day.</p>
      {total > 1 && <p class="page-count">Page {current} of {total}</p>}
    </div>
  </section>

  <section class="section">
    <div class="wrap wrap-narrow">
      {posts.length === 0 ? (
        <p>New posts are on the way. Check back soon!</p>
      ) : (
        <>
          <PostList posts={posts} />
          <Pagination current={current} total={total} />
        </>
      )}
    </div>
  </section>

  <section class="section cta-band">
    <div class="wrap cta-inner">
      <h2>Plan your best season yet.</h2>
      <p>Get the 265+ plant library, a square-foot bed planner, a planting calendar tuned to your frost dates, and yield tracking.</p>
      <div class="cta-row cta-row-center"><StoreBadges cta="blog-index-band" light /></div>
    </div>
  </section>
</BaseLayout>
