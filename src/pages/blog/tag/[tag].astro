---
/**
 * Topic hub: every post carrying one tag. Only tags with `MIN_TAG_POSTS` or
 * more get a page — see the note in lib/posts.ts.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StoreBadges from '../../../components/StoreBadges.astro';
import PostList from '../../../components/PostList.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { publishedPosts, articles, tagsWithPages, postsWithTag, tagCopy, type Post } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = articles(await publishedPosts());
  return tagsWithPages(posts).map(({ tag }) => ({
    params: { tag },
    props: { tag, posts: postsWithTag(posts, tag) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
const { label, intro } = tagCopy(tag);

const canonical = new URL(`/blog/tag/${tag}/`, Astro.site).href;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog/' },
  { name: label, href: `/blog/tag/${tag}/` },
];
---
<BaseLayout
  title={`${label} — Garden Pro Planner Blog`}
  description={intro}
  canonical={canonical}
>
  <section class="blog-hero">
    <div class="wrap wrap-narrow">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">Garden Pro Planner Blog</p>
      <h1>{label}</h1>
      <p class="lead">{intro}</p>
      <p class="page-count">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap wrap-narrow">
      <PostList posts={posts} currentTag={tag} />
      <p class="tag-back"><a href="/blog/">← All posts</a></p>
    </div>
  </section>

  <section class="section cta-band">
    <div class="wrap cta-inner">
      <h2>Plan your best season yet.</h2>
      <p>Get the 265+ plant library, a square-foot bed planner, a planting calendar tuned to your frost dates, and yield tracking.</p>
      <div class="cta-row cta-row-center"><StoreBadges cta="blog-tag-band" light /></div>
    </div>
  </section>
</BaseLayout>
