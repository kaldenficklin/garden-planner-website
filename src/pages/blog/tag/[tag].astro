---
/**
 * Topic hub: every post carrying one tag. Only tags with `MIN_TAG_POSTS` or
 * more get a page — see the note in lib/posts.ts.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { publishedPosts, tagsWithPages, postsWithTag, tagCopy, type Post } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return tagsWithPages(posts).map(({ tag }) => ({
    params: { tag },
    props: { tag, posts: postsWithTag(posts, tag) },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
const { label, intro } = tagCopy(tag);

const canonical = new URL(`/blog/tag/${tag}/`, Astro.site).href;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog/' },
  { name: label, href: `/blog/tag/${tag}/` },
];
---
<BaseLayout
  title={`${label} — Garden Pro Planner Blog`}
  description={intro}
  canonical={canonical}
>
  <section class="blog-hero">
    <div class="wrap wrap-narrow">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">Garden Pro Planner Blog</p>
      <h1>{label}</h1>
      <p class="lead">{intro}</p>
      <p class="page-count">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap wrap-narrow">
      <PostList posts={posts} currentTag={tag} />
      <p class="tag-back"><a href="/blog/">← All posts</a></p>
    </div>
  </section>

  <section class="section cta-band">
    <div class="wrap cta-inner">
      <h2>Plan your best season yet.</h2>
      <p>Get the 265+ plant library, a square-foot bed planner, a planting calendar tuned to your frost dates, and yield tracking.</p>
      <a class="appstore appstore-light" href="https://apps.apple.com/app/id1539031278" data-cta="blog-tag-band" aria-label="Download on the App Store">
        <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="currentColor"><path d="M16.365 1.43c0 1.14-.42 2.22-1.17 3.02-.9.96-2.37 1.7-3.63 1.6-.15-1.13.41-2.32 1.11-3.06.79-.83 2.2-1.46 3.36-1.5.02.31.02.62.02.94zM20.7 17.02c-.55 1.27-.82 1.84-1.53 2.96-.99 1.56-2.39 3.5-4.12 3.51-1.54.02-1.93-.99-4.02-.98-2.09.01-2.52.99-4.06.98-1.73-.01-3.05-1.76-4.04-3.32-2.77-4.36-3.06-9.48-1.35-12.2 1.21-1.94 3.13-3.07 4.93-3.07 1.84 0 2.99 1 4.51 1 1.47 0 2.37-1 4.5-1 1.61 0 3.32.87 4.54 2.38-3.99 2.18-3.34 7.86.11 9.74z"/></svg>
        <span class="appstore-txt"><small>Download on the</small><strong>App Store</strong></span>
      </a>
    </div>
  </section>
</BaseLayout>
