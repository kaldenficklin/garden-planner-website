---
import ArticlePage from '../../components/ArticlePage.astro';
import {
  publishedPosts,
  articles,
  relatedPosts,
  tagsWithPages,
  translationOf,
  entrySlug,
  type Post,
} from '../../lib/posts';

export async function getStaticPaths() {
  const all = await publishedPosts();
  const posts = articles(all);
  const linkedTags = tagsWithPages(posts).map((t) => t.tag);
  return posts.map((post, i) => ({
    params: { slug: entrySlug(post) },
    props: {
      post,
      // The list is newest-first, so the entry before this one is the newer post.
      newer: posts[i - 1],
      older: posts[i + 1],
      related: relatedPosts(post, posts),
      linkedTags,
      translation: translationOf(post, all),
    },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
  related: Post[];
  linkedTags: string[];
  translation?: Post;
}
---
<ArticlePage {...Astro.props} />
