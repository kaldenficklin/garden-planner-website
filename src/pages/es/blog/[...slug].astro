---
/**
 * Spanish translations of blog articles, at /es/blog/<spanish-slug>/.
 *
 * Prev/next and related posts come from Spanish articles only: a Spanish
 * reader sent to an English page by "Artículo anterior" has been sent off the
 * site, as far as they're concerned. There are no Spanish tag hubs, so no
 * tags are linked.
 */
import ArticlePage from '../../../components/ArticlePage.astro';
import {
  publishedPosts,
  articles,
  relatedPosts,
  translationOf,
  entrySlug,
  type Post,
} from '../../../lib/posts';

export async function getStaticPaths() {
  const all = await publishedPosts();
  const posts = articles(all, 'es');
  return posts.map((post, i) => ({
    params: { slug: entrySlug(post) },
    props: {
      post,
      newer: posts[i - 1],
      older: posts[i + 1],
      related: relatedPosts(post, posts),
      linkedTags: [],
      translation: translationOf(post, all),
    },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
  related: Post[];
  linkedTags: string[];
  translation?: Post;
}
---
<ArticlePage {...Astro.props} />
