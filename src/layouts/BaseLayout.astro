---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Article metadata. Feeds Pinterest Article Rich Pins, which show the
   *  headline, author, publish date and site name on every pin from this
   *  domain once the domain is claimed on Pinterest. */
  publishedTime?: string;
  modifiedTime?: string;
  articleTags?: string[];
  /** Page language. Sets <html lang> and og:locale. */
  lang?: 'en' | 'es';
  /**
   * hreflang alternates for a translated page. Every version of a page must
   * list every version including itself, plus an x-default — Google ignores a
   * one-sided set, which is the usual way an i18n rollout quietly does nothing.
   */
  alternates?: { lang: string; href: string }[];
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, Astro.site).href,
  image = 'https://thegardenplanner.app/assets/app-icon.png',
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  articleTags = [],
  lang = 'en',
  alternates = [],
} = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
  {noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    /* max-image-preview:large is the gate for Google Discover's large cards and
       for full-width image previews in Search. The post heroes are 1200x800,
       comfortably over the 1200px width Discover wants. The two -1 values lift
       the default caps on snippet length and video preview length. */
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  )}

  <!-- Open Graph -->
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={image} />
  <meta property="og:site_name" content="Garden Pro Planner" />
  <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
  {type === 'article' && (
    <>
      <meta property="article:author" content="Garden Pro Planner" />
      {publishedTime && <meta property="article:published_time" content={publishedTime} />}
      {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
      {articleTags.map((t) => <meta property="article:tag" content={t} />)}
    </>
  )}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <link rel="icon" type="image/png" href="/assets/app-icon.png" />
  <link rel="apple-touch-icon" href="/assets/app-icon.png" />

  <link rel="alternate" type="application/rss+xml" title="Garden Pro Planner Blog" href="/blog/rss.xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Loaded without blocking the first paint: the print media query makes
       the browser fetch it at low priority, and onload promotes it. The
       stylesheet already carries display=swap, so text is visible throughout. -->
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" /></noscript>
  <link rel="stylesheet" href="/assets/style.css?v=3" />
  <!-- Bump ?v= on every edit to these files. /assets/* is served immutable for
       a year, so a changed stylesheet under an unchanged query string never
       reaches anyone who has already visited. -->
  <link rel="stylesheet" href="/assets/blog.css?v=6" />

  <script defer src="/assets/analytics.js?v=2" is:inline></script>
  <script defer src="/assets/site.js?v=1" is:inline></script>
  <slot name="head" />
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/">
        <span class="brand-mark">G</span>
        <span class="brand-name">Garden Pro Planner</span>
      </a>
      <nav class="nav">
        <a href="/#features">Features</a>
        <a href="/blog">Blog</a>
        <a href="/#faq">FAQ</a>
        <a class="btn btn-sm" href="https://apps.apple.com/app/id1539031278" data-cta="header">
          <svg class="btn-icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="currentColor"><path d="M16.365 1.43c0 1.14-.42 2.22-1.17 3.02-.9.96-2.37 1.7-3.63 1.6-.15-1.13.41-2.32 1.11-3.06.79-.83 2.2-1.46 3.36-1.5.02.31.02.62.02.94zM20.7 17.02c-.55 1.27-.82 1.84-1.53 2.96-.99 1.56-2.39 3.5-4.12 3.51-1.54.02-1.93-.99-4.02-.98-2.09.01-2.52.99-4.06.98-1.73-.01-3.05-1.76-4.04-3.32-2.77-4.36-3.06-9.48-1.35-12.2 1.21-1.94 3.13-3.07 4.93-3.07 1.84 0 2.99 1 4.51 1 1.47 0 2.37-1 4.5-1 1.61 0 3.32.87 4.54 2.38-3.99 2.18-3.34 7.86.11 9.74z"/></svg>
          <span>Get the app</span>
        </a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div class="footer-brand">
        <span class="brand-mark">G</span>
        <span>Garden Pro Planner</span>
      </div>
      <nav class="footer-nav">
        <a href="/">Home</a>
        <a href="/blog">Blog</a>
        <a href="/about">About</a>
        <a href="/privacy">Privacy</a>
        <a href="/support">Support</a>
        <a href="https://apps.apple.com/app/id1539031278" data-cta="footer-link">App Store</a>
      </nav>
      <p class="copyright">© <span id="year">2026</span> Garden Pro Planner. All rights reserved.</p>
    </div>
  </footer>

  <!-- Phone-only download bar; slides up once the reader has scrolled in. -->
  <div class="mobile-cta">
    <div class="mobile-cta-inner">
      <img class="mobile-cta-icon" src="/assets/app-icon.png" alt="" width="44" height="44" />
      <span class="mobile-cta-text">
        <strong>Garden Pro Planner</strong>
        <span>Free · iPhone &amp; iPad</span>
      </span>
      <a class="btn mobile-cta-btn" href="https://apps.apple.com/app/id1539031278" data-cta="sticky-bar">Get</a>
    </div>
  </div>

  <script>document.getElementById('year').textContent = String(new Date().getFullYear());</script>
</body>
</html>
